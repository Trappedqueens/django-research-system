# Reference only: Django reads OS environment variables, not this file automatically.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For production, generate a private random key; never commit its real value.
DJANGO_SECRET_KEY=django-insecure-local-development-only
DB_NAME=research_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional demonstration data: explicitly set all three before running init_data.py.
DEMO_ADMIN_PASSWORD=
DEMO_TEACHER_PASSWORD=
DEMO_EXPERT_PASSWORD=
